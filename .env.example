# Copy to .env and fill in values. Loaded at startup by internal/envfile.
# Real environment variables always take priority over values in this file.

# Shared bearer token Miranda presents to call this service's MCP tools.
# Generate with: openssl rand -hex 32
YAZIO_MCP_TOKEN=

# YAZIO account credentials (the same ones used to log into the YAZIO
# mobile app). One pair per configured user in config/config.yaml's
# yazio.users list — names below match yazio.users[].username_env/
# password_env for the "archer" user. To add another household member,
# add a users[] entry in config.yaml and its own pair of env vars here.
# Used once per account for the OAuth password grant; after that, the
# service refreshes its own token and caches it under
# $XDG_CONFIG_HOME/yazio-mcp/token-<name>.json (or
# ~/.config/yazio-mcp/token-<name>.json).
YAZIO_USERNAME_ARCHER=
YAZIO_PASSWORD_ARCHER=
